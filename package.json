{
  "name": "@xd-hhz/dsh-word-editor",
  "version": "1.0.0",
  "description": "Open, edit and save .docx documents in the DeepSeek Harness right-sidebar document tab",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "docx",
    "word",
    "editor"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XD-HHZ/dsh-word-editor.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "smoke": "node smoke-client.mjs",
    "roundtrip": "node test/roundtrip.mjs",
    "test": "npm run check && npm run smoke && npm run roundtrip"
  }
}
